# Supabase — copie para .env.local e preencha com os valores do seu projeto.

# URL pública do site (links de confirmação/recuperação por e-mail).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cliente (browser + server) — Connect > Framework, ou Settings > Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (somente server) — Settings > API Keys > secret key (sb_secret_...)
SUPABASE_SECRET_KEY=

# Banco (Prisma) — Connect > ORM > Prisma. Substitua [YOUR-PASSWORD] pela
# Database Password do projeto (codificada para URL se tiver caracteres especiais).
# Pooler em modo transação (porta 6543) — usado pela aplicação em runtime.
DATABASE_URL=
# Pooler em modo sessão / conexão direta (porta 5432) — usado pelas migrations.
DIRECT_URL=

# IA — assistente de chat (Groq, grátis e sem cartão).
# Chave gratuita em console.groq.com/keys.
GROQ_API_KEY=

# IA (Google Gemini) — importação de PDF e estimativa por foto.
# Chave gratuita em aistudio.google.com/apikey (cota grátis do gemini-2.5-flash).
GEMINI_API_KEY=

# Login com Google — configure o provedor Google em Authentication > Providers
# no Supabase. O Client ID e o Client Secret ficam no painel do Supabase, não aqui.
# Também adicione https://SEU-PROJETO.supabase.co/auth/v1/callback no Google Cloud.

# Assinaturas Stripe — use chaves de teste enquanto estiver validando o checkout.
# Crie um Produto com Preço recorrente mensal e copie o identificador price_... abaixo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
