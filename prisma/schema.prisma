// Schema do banco — Órbita
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Sexo biológico — usado nas estimativas de TMB/GET.
enum Sex {
  MALE
  FEMALE
  OTHER
}

/// Nível de atividade física para o cálculo do gasto energético diário.
enum ActivityLevel {
  SEDENTARY // pouco ou nenhum exercício
  LIGHT // 1-3 treinos por semana
  MODERATE // 3-5 treinos por semana
  ACTIVE // 6-7 treinos por semana
  VERY_ACTIVE // treino pesado diário ou trabalho físico
}

/// Objetivo principal declarado no onboarding.
enum GoalType {
  LOSE_WEIGHT
  MAINTAIN_WEIGHT
  GAIN_WEIGHT
  GAIN_MUSCLE
  IMPROVE_FITNESS
}

/// Situação de um treino.
enum WorkoutStatus {
  PLANNED // agendado, ainda não feito
  COMPLETED // realizado
  SKIPPED // estava planejado e não foi feito
}

/// O que uma meta acompanha. Define de onde vem o valor atual.
enum GoalMetric {
  WEIGHT // peso corporal (kg)
  BODY_FAT // percentual de gordura
  MEASUREMENT // uma circunferência (cm) — `metricKey` diz qual
  EXERCISE_LOAD // carga máxima de um exercício (kg) — `metricKey` é o nome
  WORKOUT_FREQUENCY // treinos realizados por semana
  CUSTOM // valor atualizado manualmente pelo usuário
}

/// Situação de uma meta.
enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

/// Momento da refeição.
enum MealType {
  BREAKFAST // café da manhã
  MORNING_SNACK // lanche da manhã
  LUNCH // almoço
  AFTERNOON_SNACK // lanche da tarde
  DINNER // jantar
  SUPPER // ceia
  OTHER
}

/// Origem de uma importação confirmada pelo usuário.
enum ImportKind {
  WORKOUTS
  MEALS
  MEASUREMENTS
}

/// Plano de acesso. A cobrança futura troca este campo após a confirmação do
/// pagamento; o servidor usa o plano para aplicar as cotas de recursos.
enum SubscriptionPlan {
  FREE
  PRO
}

/// Perfil do usuário. O `id` é igual ao id do usuário no Supabase Auth
/// (auth.users.id). Cada conta tem no máximo um perfil.
model Profile {
  id             String         @id @db.Uuid
  fullName       String         @map("full_name")
  birthDate      DateTime?      @map("birth_date") @db.Date
  sex            Sex?
  heightCm       Int?           @map("height_cm")
  activityLevel  ActivityLevel? @map("activity_level")
  goalType       GoalType?      @map("goal_type")
  targetWeightKg Float?         @map("target_weight_kg")
  targetCalories Int?           @map("target_calories")
  targetProteinG Int?           @map("target_protein_g")
  targetCarbsG   Int?           @map("target_carbs_g")
  targetFatG     Int?           @map("target_fat_g")
  subscriptionPlan             SubscriptionPlan @default(FREE) @map("subscription_plan")
  stripeCustomerId             String?          @unique @map("stripe_customer_id")
  stripeSubscriptionId         String?          @unique @map("stripe_subscription_id")
  subscriptionStatus           String?          @map("subscription_status")
  subscriptionCurrentPeriodEnd DateTime?        @map("subscription_current_period_end") @db.Timestamptz(6)
  onboardedAt    DateTime?      @map("onboarded_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  weightEntries      WeightEntry[]
  measurementEntries MeasurementEntry[]
  workouts           Workout[]
  meals              Meal[]
  goals              Goal[]
  documents          FileDocument[]
  chatMessages       ChatMessage[]
  aiUsageWindows     AiUsageWindow[]
  importOperations   ImportOperation[]

  @@map("profiles")
}

/// Registro de peso corporal. No máximo um por dia (por perfil).
model WeightEntry {
  id        Int      @id @default(autoincrement())
  profileId String   @map("profile_id") @db.Uuid
  date      DateTime @db.Date
  weightKg  Float    @map("weight_kg")
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@index([profileId, date])
  @@map("weight_entries")
}

/// Registro de medidas corporais (circunferências e % de gordura). No máximo
/// um por dia (por perfil). Todos os campos de medida são opcionais.
model MeasurementEntry {
  id         Int      @id @default(autoincrement())
  profileId  String   @map("profile_id") @db.Uuid
  date       DateTime @db.Date
  neckCm     Float?   @map("neck_cm")
  chestCm    Float?   @map("chest_cm")
  waistCm    Float?   @map("waist_cm")
  hipCm      Float?   @map("hip_cm")
  armCm      Float?   @map("arm_cm")
  thighCm    Float?   @map("thigh_cm")
  calfCm     Float?   @map("calf_cm")
  bodyFatPct Float?   @map("body_fat_pct")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@index([profileId, date])
  @@map("measurement_entries")
}

/// Um treino realizado ou planejado.
model Workout {
  id           Int           @id @default(autoincrement())
  profileId    String        @map("profile_id") @db.Uuid
  name         String
  muscleGroups String[]      @map("muscle_groups")
  date         DateTime      @db.Date
  durationMin  Int?          @map("duration_min")
  status       WorkoutStatus @default(COMPLETED)
  note         String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  exercises Exercise[]

  @@index([profileId, date])
  @@index([profileId, status])
  @@map("workouts")
}

/// Um exercício dentro de um treino.
model Exercise {
  id        Int      @id @default(autoincrement())
  workoutId Int      @map("workout_id")
  name      String
  position  Int      @default(0)
  sets      Int?
  reps      Int?
  weightKg  Float?   @map("weight_kg")
  restSec   Int?     @map("rest_sec")
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
  @@index([name])
  @@map("exercises")
}

/// Uma refeição de um dia.
model Meal {
  id        Int      @id @default(autoincrement())
  profileId String   @map("profile_id") @db.Uuid
  date      DateTime @db.Date
  type      MealType
  time      String? // "HH:MM" opcional
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items   FoodItem[]

  @@index([profileId, date])
  @@map("meals")
}

/// Um alimento dentro de uma refeição. Valores nutricionais são estimativas
/// informadas pelo usuário.
model FoodItem {
  id        Int      @id @default(autoincrement())
  mealId    Int      @map("meal_id")
  name      String
  quantity  String? // texto livre: "150 g", "1 unidade"
  position  Int      @default(0)
  calories  Float?
  proteinG  Float?   @map("protein_g")
  carbsG    Float?   @map("carbs_g")
  fatG      Float?   @map("fat_g")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@map("food_items")
}

/// Uma meta pessoal. `startValue`/`targetValue` definem a direção
/// (target < start = reduzir). Para `CUSTOM`, `currentValue` é atualizado
/// à mão; nas demais métricas o valor atual é calculado dos registros.
model Goal {
  id           Int         @id @default(autoincrement())
  profileId    String      @map("profile_id") @db.Uuid
  title        String
  description  String?
  metric       GoalMetric
  metricKey    String?     @map("metric_key")
  startValue   Float       @map("start_value")
  targetValue  Float       @map("target_value")
  currentValue Float?      @map("current_value")
  deadline     DateTime?   @db.Date
  status       GoalStatus  @default(ACTIVE)
  achievedAt   DateTime?   @map("achieved_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@map("goals")
}

/// Autor de uma mensagem do assistente.
enum ChatRole {
  USER
  ASSISTANT
}

/// Categoria de um documento anexado.
enum DocumentCategory {
  WORKOUT_PLAN // ficha de treino
  DIET_PLAN // plano alimentar
  ASSESSMENT // avaliação física
  EXAM // exame
  REPORT // relatório
  OTHER
}

/// Metadados de um arquivo (PDF) guardado no Supabase Storage. O binário
/// fica no bucket `documentos`; aqui só a referência.
model FileDocument {
  id          Int              @id @default(autoincrement())
  profileId   String           @map("profile_id") @db.Uuid
  name        String
  category    DocumentCategory  @default(OTHER)
  description String?
  storagePath String           @map("storage_path")
  sizeBytes   Int              @map("size_bytes")
  mimeType    String?          @map("mime_type")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, category])
  @@map("file_documents")
}

/// Uma mensagem da conversa com o assistente de IA.
model ChatMessage {
  id        Int      @id @default(autoincrement())
  profileId String   @map("profile_id") @db.Uuid
  role      ChatRole
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("chat_messages")
}

/// Contador de uso do assistente numa janela fixa. A chave composta permite
/// atualizar o limite de forma atômica, sem depender de memória do servidor.
model AiUsageWindow {
  profileId          String   @map("profile_id") @db.Uuid
  windowStartedAt    DateTime @map("window_started_at") @db.Timestamptz(6)
  textRequests       Int      @default(0) @map("text_requests")
  attachmentRequests Int      @default(0) @map("attachment_requests")
  pdfExports         Int      @default(0) @map("pdf_exports")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, windowStartedAt])
  @@map("ai_usage_windows")
}

/// Registro da confirmação de uma importação. A combinação de perfil,
/// tipo e identificador do navegador impede que uma nova tentativa grave o
/// mesmo lote duas vezes.
model ImportOperation {
  id            BigInt     @id @default(autoincrement())
  profileId     String     @map("profile_id") @db.Uuid
  kind          ImportKind
  requestId     String     @map("request_id") @db.Uuid
  payloadHash   String     @map("payload_hash") @db.Char(64)
  resultMessage String     @map("result_message")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, kind, requestId])
  @@map("import_operations")
}
